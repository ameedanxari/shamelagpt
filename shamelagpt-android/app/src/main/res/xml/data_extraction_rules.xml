<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude session_prefs from cloud backup and device transfer (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session_prefs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session_prefs" />
    </device-transfer>
</data-extraction-rules>
