// MARK: - About Screen

"about.content" = "ShamelaGPT is an AI-powered Islamic knowledge assistant built upon the vast and trusted library of Shamela.ws. Our mission is to make reliable, reference-based Islamic knowledge accessible to everyone in a natural and conversational way.\n\nWe combine cutting-edge AI technology with authentic Islamic sources to provide accurate answers, backed by proper references from classical and contemporary Islamic scholarship.";
"about.missionTitle" = "Our Mission";
"about.mission" = "To provide reliable, AI-powered access to authentic Islamic knowledge for research, education, and fact-checking—without replacing scholarship or religious authority.";
"about.mission.pointSupport" = "Support students, researchers, educators, and developers";
"about.mission.pointCombatMisinformation" = "Combat misinformation and misrepresentation of Islam online";
"about.mission.pointEthicalAI" = "Enable ethical AI use in Islamic knowledge systems";
"about.mission.pointPreserveTrust" = "Preserve trust by prioritizing sources, citations, and context";
"about.visionTitle" = "Our Vision";
"about.visionIntro" = "We envision a future where:";
"about.vision.pointSources" = "Authentic Islamic sources are the foundation of AI-driven knowledge tools";
"about.vision.pointVerifiable" = "Islamic information online is verifiable, contextual, and responsibly delivered";
"about.vision.pointUnderrepresented" = "Underrepresented languages and communities gain equal access to trusted knowledge";
"about.vision.pointChildren" = "Children and new reverts receive age-appropriate, compassionate explanations";
"about.vision.pointDevelopers" = "Developers and institutions can build on open, auditable knowledge infrastructure";
"about.goalTitle" = "Our Goal";
"about.goal" = "ShamelaGPT was created to help close this gap by offering AI tools grounded in authentic sources, with transparency, traceability, and context at the core.";
"about.dataSourceTitle" = "Data Source";
"about.dataSource" = "All responses are generated using the comprehensive library of Shamela.ws, one of the most trusted and extensive digital Islamic libraries available today.";
"about.dataHandlingTitle" = "How we handle your data";
